# Mapbox public access token; create .env locally and set your own token.
VITE_MAPBOX_TOKEN=

# Optional MapLibre test style URL. Defaults to OpenFreeMap Liberty.
# VITE_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Java backend production variables (export these in the server environment)
SPRING_PROFILES_ACTIVE=prod
PHOTOMAP_DB_URL=jdbc:postgresql://localhost:5432/photomap
PHOTOMAP_DB_USERNAME=photomap
PHOTOMAP_DB_PASSWORD=
PHOTOMAP_JWT_SECRET=
PHOTOMAP_CORS_ALLOWED_ORIGINS=https://your-domain.example
