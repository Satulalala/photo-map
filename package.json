{
  "name": "photo-map",
  "version": "1.0.0",
  "description": "智能照片地图与 AI 知识检索平台",
  "author": "Satula <1920393579@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/Satulalala/photo-map",
  "repository": {
    "type": "git",
    "url": "https://github.com/Satulalala/photo-map.git"
  },
  "bugs": {
    "url": "https://github.com/Satulalala/photo-map/issues"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/check-native.cjs",
    "dev": "concurrently \"npm run vite-dev\" \"wait-on http://localhost:3000 && electron .\"",
    "vite-dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "web:dev": "cross-env BUILD_TARGET=web vite",
    "web:build": "cross-env BUILD_TARGET=web vite build",
    "web:preview": "cross-env BUILD_TARGET=web vite preview",
    "build:all": "npm run build && npm run web:build",
    "electron-build": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "rebuild": "electron-rebuild",
    "native:check": "node scripts/check-native.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src src-web --quiet",
    "lint:fix": "eslint src src-web --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "precommit": "lint-staged",
    "docs": "jsdoc -c jsdoc.config.json",
    "docs:serve": "npx serve docs/api",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o docs/storybook",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:report": "npm audit --json > audit-report.json",
    "clean": "rimraf dist build node_modules/.vite",
    "clean:all": "rimraf dist build node_modules",
    "setup": "node scripts/setup.js",
    "setup:monitoring": "node scripts/setup-monitoring.js",
    "setup:hooks": "husky",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "version:bump": "node scripts/version-manager.js bump",
    "version:bump:minor": "node scripts/version-manager.js bump minor",
    "version:bump:major": "node scripts/version-manager.js bump major",
    "version:prerelease": "node scripts/version-manager.js prerelease",
    "version:info": "node scripts/version-manager.js info",
    "version:generate": "node scripts/version-manager.js generate",
    "monitor:report": "node -e \"const m = require('./src/utils/monitoring.js').default; m.generateReport().then(console.log)\"",
    "monitor:export": "node -e \"const m = require('./src/utils/monitoring.js').default; m.exportData()\"",
    "perf:report": "node -e \"console.log('在浏览器控制台运行: window.__PERF__.printReport()')\"",
    "menu": "node -e \"console.log('\\n🚀 快速启动:\\n'); console.log('Windows: 双击 start.bat'); console.log('PowerShell: .\\\\start.ps1'); console.log('Linux/macOS: ./start.sh'); console.log('\\n📖 开发命令:\\n'); console.log('npm run dev      # Electron 版本'); console.log('npm run web:dev  # Web 版本'); console.log('npm run setup    # 项目设置'); console.log('npm run test     # 运行测试'); console.log('npm run lint     # 代码检查'); console.log('npm run format   # 格式化代码');\"",
    "env:check": "node scripts/check-environment.cjs",
    "server:dev": "powershell -ExecutionPolicy Bypass -File scripts/backend.ps1",
    "server:verify": "powershell -ExecutionPolicy Bypass -File scripts/backend.ps1 verify"
  },
  "build": {
    "appId": "com.photomap.app",
    "productName": "地图相册",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/database.cjs",
      "!node_modules/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/electron-log/**/*",
      "node_modules/sharp/**/*",
      "node_modules/exif-parser/**/*",
      "node_modules/uuid/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/better-sqlite3/prebuilds",
        "to": "better-sqlite3",
        "filter": [
          "*.node"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "**/*.node"
    ],
    "compression": "maximum",
    "removePackageScripts": true,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "地图相册",
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.photography",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Photography",
      "maintainer": "Satula <1920393579@qq.com>",
      "desktop": {
        "Name": "地图相册",
        "Comment": "在地图上标记和管理照片",
        "Categories": "Photography;Graphics;"
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Satulalala",
      "repo": "photo-map",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/three": "^0.186.0",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.10",
    "exif-parser": "^0.1.12",
    "gsap": "^3.15.0",
    "lottie-react": "^2.4.2",
    "node-abi": "^4.36.0",
    "onnxruntime-node": "^1.30.0",
    "pinyin-pro": "^3.29.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "sharp": "^0.35.5",
    "sqlite-vec": "^0.1.9",
    "supercluster": "^8.0.1",
    "three": "^0.186.1",
    "uuid": "^11.1.1",
    "v8-compile-cache": "^2.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "clean-jsdoc-theme": "^5.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fs-extra": "^11.4.1",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prop-types": "^15.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "jsdom": "^30.1.2",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.3.2",
    "semver": "^7.7.3"
  },
  "engines": {
    "node": ">=22.23.2 <23 || >=24.0.0 <25",
    "npm": ">=10"
  }
}
